# ==============================================================================
# Hermes + Antigravity + OpenWA on Railway - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual production values.
# NEVER commit .env to version control!

# ------------------------------------------------------------------------------
# 1. Hermes Agent & API Server Settings
# ------------------------------------------------------------------------------
# Secret key used to authenticate internal requests to the Hermes API Server.
# Generate with: openssl rand -hex 32
HERMES_API_KEY=replace_with_strong_random_hermes_api_key_32_chars

# Port on which the Hermes API server listens internally (default: 8642)
HERMES_API_PORT=8642

# Base URL for the Hermes API server.
# In Railway private networking, the router talks to Hermes locally or via internal DNS.
HERMES_BASE_URL=http://127.0.0.1:8642

# ------------------------------------------------------------------------------
# 2. WhatsApp Integration Router Settings
# ------------------------------------------------------------------------------
# Port for the WhatsApp message router / webhook intake server (default: 8080)
PORT=8080

# Optional secret header for webhook validation (X-Webhook-Secret)
WEBHOOK_SECRET=replace_with_optional_webhook_secret_or_leave_empty

# Comma-separated list of authorized international WhatsApp phone numbers
# Only messages from these numbers will be processed by Hermes.
# Example: 15551234567,919876543210
ALLOWED_WHATSAPP_NUMBERS=15551234567

# Default response to send when an unauthorized number messages the bot.
# Set to 'ignore' to silently drop unauthorized messages (recommended for security).
UNAUTHORIZED_RESPONSE=Access denied. This is a private personal AI agent.

# ------------------------------------------------------------------------------
# 3. OpenWA (WhatsApp Gateway) Settings
# ------------------------------------------------------------------------------
# Secret API key used to protect the OpenWA REST API.
# Generate with: openssl rand -hex 32
OPENWA_API_KEY=replace_with_strong_random_openwa_api_key_32_chars

# Internal port for OpenWA (default: 2785)
OPENWA_PORT=2785

# Base URL for OpenWA REST API.
# On Railway, Hermes talks to OpenWA over Railway Private Networking:
# OPENWA_BASE_URL=http://openwa.railway.internal:2785
# In local docker-compose:
OPENWA_BASE_URL=http://openwa:2785

# Webhook URL where OpenWA sends incoming WhatsApp messages.
# On Railway: http://hermes.railway.internal:8080/webhook/whatsapp
# In local docker-compose: http://hermes:8080/webhook/whatsapp
OPENWA_WEBHOOK_URL=http://hermes:8080/webhook/whatsapp

# ------------------------------------------------------------------------------
# 4. Antigravity & AI Provider Settings
# ------------------------------------------------------------------------------
# Antigravity CLI uses headless Google OAuth persisted in the persistent volume (~/.gemini).
# To provide a direct fallback or model provider for Hermes:
GEMINI_API_KEY=replace_with_your_google_ai_studio_api_key_if_using_gemini_directly

# Model selected for Antigravity tasks (e.g., 'Gemini 3.1 Pro (High)', 'Gemini 3 Flash (High)')
AGY_DEFAULT_MODEL=Gemini 3.1 Pro (High)

# ------------------------------------------------------------------------------
# 5. Persistent Storage Paths (Containers)
# ------------------------------------------------------------------------------
# Hermes data path inside the container (mounted from Railway Volume 'hermes-data')
HERMES_DATA_PATH=/opt/data

# OpenWA data path inside the container (mounted from Railway Volume 'openwa-data')
OPENWA_DATA_PATH=/app/data
