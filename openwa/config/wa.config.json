{
  "sessionId": "default",
  "multiDevice": true,
  "headless": true,
  "useChrome": true,
  "qrTimeout": 0,
  "authTimeout": 0,
  "autoRefresh": true,
  "killProcessOnBrowserClose": false,
  "restartOnCrash": true,
  "cacheEnabled": true,
  "bypassCSP": true,
  "chromiumArgs": [
    "--no-sandbox",
    "--disable-setuid-sandbox",
    "--disable-dev-shm-usage",
    "--disable-gpu",
    "--no-first-run",
    "--no-zygote"
  ]
}
